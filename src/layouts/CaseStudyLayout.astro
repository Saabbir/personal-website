---
import BaseLayout from './BaseLayout.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import { SITE_ORIGIN, canonicalForPath, formatWorkDate, toIsoDate } from '../utils/seo';
import {
  caseEyebrow,
  caseLayoutKind,
  formatVisitors,
  liveLabel,
  withCaseHeadingIds,
} from '../utils/work';

interface Metric {
  label: string;
  value: string;
  baseline?: string;
  variation?: string;
  featured?: boolean;
}

interface RelatedItem {
  slug: string;
  title: string;
  highlight?: string | null;
  type?: string | null;
  metric?: string | null;
  metricLabel?: string | null;
}

interface MetaItem {
  label: string;
  value: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string | null;
  highlight?: string | null;
  createdAt?: string | null;
  type?: string | null;
  tools?: string[];
  url?: string | null;
  cover?: string | null;
  agency?: string | null;
  client?: string | null;
  eyebrow?: string | null;
  tool?: string | null;
  duration?: string | null;
  dateRange?: string | null;
  visitors?: string | number | null;
  trafficSplit?: string | null;
  scope?: string | null;
  caseLayout?: 'ab-test' | 'performance' | 'shopify' | 'analytics' | 'other' | null;
  metric?: string | null;
  metricLabel?: string | null;
  metrics?: Metric[];
  ogImage?: string;
  download?: {
    href: string;
    filename?: string;
    label?: string;
  } | null;
  related?: RelatedItem[];
}

const {
  title,
  description,
  highlight,
  createdAt,
  type = 'Project',
  tools = [],
  url,
  cover,
  agency,
  client,
  eyebrow,
  tool,
  duration,
  dateRange,
  visitors,
  trafficSplit,
  scope,
  caseLayout,
  metric,
  metricLabel,
  metrics = [],
  download = null,
  ogImage,
  related = [],
} = Astro.props;

const kind = caseLayoutKind(type, caseLayout);
const eyebrowText = caseEyebrow(kind, type, eyebrow);
const crumbLabel = client || title;
const showCover = Boolean(cover) && kind === 'shopify';
const sourcedMetrics = metrics.length > 0
  ? metrics
  : metric
    ? [{ label: metricLabel || 'Headline result', value: metric, featured: true }]
    : [];
const heroMetrics = [
  ...sourcedMetrics.filter((item) => item.featured),
  ...sourcedMetrics.filter((item) => !item.featured),
].slice(0, 4);

const dates = formatWorkDate(dateRange, createdAt);
const primaryTool = tool || tools[0] || '';
const visitorLabel = formatVisitors(visitors);

const pageUrl = canonicalForPath(Astro.url.pathname);
const { html: caseBody, toc: tocItems } = withCaseHeadingIds(await Astro.slots.render('default'));
const showRail = tocItems.length > 0 || Boolean(download);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_ORIGIN}/` },
    { "@type": "ListItem", "position": 2, "name": "Work", "item": `${SITE_ORIGIN}/work/` },
    { "@type": "ListItem", "position": 3, "name": title, "item": pageUrl },
  ],
};

const caseSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description || highlight || "",
  "url": pageUrl,
  "image": new URL(ogImage || '/images/og/default.png', SITE_ORIGIN).href,
  "author": { "@type": "Person", "name": "Saabbir Hossain", "url": SITE_ORIGIN },
  "publisher": { "@type": "Person", "name": "Saabbir Hossain", "url": SITE_ORIGIN },
  "datePublished": toIsoDate(createdAt),
  "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
  ...(client ? { about: { "@type": "Organization", name: client } } : {}),
  ...(agency ? { contributor: { "@type": "Organization", name: agency, url: "https://echologyx.com/" } } : {}),
};

const metaItems: MetaItem[] = [];

if (agency) metaItems.push({ label: 'Agency', value: agency });
if (client) metaItems.push({ label: 'Client', value: client });

if (kind === 'ab-test') {
  if (primaryTool) metaItems.push({ label: 'Tool', value: primaryTool });
  if (duration) metaItems.push({ label: 'Duration', value: duration });
  if (dates) metaItems.push({ label: 'Dates', value: dates });
  if (visitorLabel) metaItems.push({ label: 'Visitors', value: visitorLabel });
  if (trafficSplit) metaItems.push({ label: 'Split', value: trafficSplit });
} else if (kind === 'performance') {
  metaItems.push({ label: 'Lab', value: primaryTool || 'WebPageTest' });
  if (scope) metaItems.push({ label: 'Page', value: scope });
  if (dates) metaItems.push({ label: 'Dates', value: dates });
  if (url) metaItems.push({ label: 'Live site', value: liveLabel(url), href: url });
} else if (kind === 'shopify') {
  metaItems.push({ label: 'Platform', value: primaryTool || 'Shopify' });
  if (dates) metaItems.push({ label: 'Date', value: dates });
  if (url) metaItems.push({ label: 'Live site', value: liveLabel(url), href: url });
} else if (kind === 'analytics') {
  if (primaryTool) metaItems.push({ label: 'Tool', value: primaryTool });
  if (dates) metaItems.push({ label: 'Date', value: dates });
  if (duration) metaItems.push({ label: 'Duration', value: duration });
} else {
  if (dates) metaItems.push({ label: 'Date', value: dates });
  if (url) metaItems.push({ label: 'Live site', value: liveLabel(url), href: url });
}
---

<BaseLayout
  title={title}
  description={description || highlight || undefined}
  image={ogImage}
  imageAlt={highlight || title}
  type="article"
  publishedTime={toIsoDate(createdAt)}
  schema={[breadcrumbSchema, caseSchema]}
>
  <article class={`c-case c-case--${kind}`}>
    <header class="c-case-hero">
      <div class="l-container">
        <div class="c-case-hero__inner">
          <nav class="c-case-hero__crumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="c-case-hero__crumb-sep" aria-hidden="true">›</span>
            <a href="/work">Work</a>
            <span class="c-case-hero__crumb-sep" aria-hidden="true">›</span>
            <span>{crumbLabel}</span>
          </nav>

          <p class="c-case-hero__eyebrow">{eyebrowText}</p>
          <h1 class="c-case-hero__title">{title}</h1>

          {highlight && <p class="c-case-hero__lede">{highlight}</p>}

          {metaItems.length > 0 && (
            <dl class="c-case-hero__meta">
              {metaItems.map((item) => (
                <div class="c-case-hero__meta-item">
                  <dt>{item.label}</dt>
                  <dd>
                    {item.href ? (
                      <a href={item.href} target="_blank" rel="noopener noreferrer">
                        {item.value}
                      </a>
                    ) : (
                      item.value
                    )}
                  </dd>
                </div>
              ))}
            </dl>
          )}

          {heroMetrics.length > 0 && (
            <div class="c-case-hero__metrics">
              {heroMetrics.map((item) => (
                <div class:list={['c-case-hero__metric', item.featured && 'c-case-hero__metric--featured']}>
                  <div class="c-case-hero__metric-value">{item.value}</div>
                  <div class="c-case-hero__metric-label">{item.label}</div>
                  {item.baseline && item.variation && (
                    <div class="c-case-hero__metric-delta">
                      {item.baseline} to {item.variation}
                    </div>
                  )}
                </div>
              ))}
            </div>
          )}

          {kind !== 'ab-test' && tools.length > 0 && (
            <ul class="c-case-hero__tools">
              {tools.map((item) => (
                <li class="c-case-hero__tool">{item}</li>
              ))}
            </ul>
          )}

          {download && (
            <div class="c-case-hero__actions">
              <a
                class="c-btn c-btn--secondary"
                href={download.href}
                download={download.filename || true}
              >
                <svg class="c-btn__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                {download.label || 'Download case study'}
              </a>
            </div>
          )}
        </div>
      </div>
    </header>

    <div class="c-case__body">
      <div class="l-container">
        <div class="c-case__shell">
          <div class="c-case__main">
            {showCover && (
              <img
                class="c-case__cover"
                src={cover}
                alt={`${title} cover`}
                width="1600"
                height="1200"
              />
            )}

            <div class="c-prose c-prose--case" set:html={caseBody} />
          </div>

          <aside class="c-case-rail" data-case-rail hidden={!showRail}>
            {tocItems.length > 0 && (
              <nav class="c-case-toc" aria-label="On this page">
                <p class="c-case-toc__label">Contents</p>
                <ul class="c-case-toc__list" data-case-toc>
                  {tocItems.map((item) => (
                    <li>
                      <a href={`#${item.id}`} class="c-case-toc__link">
                        {item.kicker ? (
                          <>
                            <span class="c-case-toc__kicker">{item.kicker}</span>
                            <span class="c-case-toc__title">{item.label}</span>
                          </>
                        ) : (
                          item.label
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
            {download && (
              <a
                class="c-btn c-btn--secondary c-case-rail__download"
                href={download.href}
                download={download.filename || true}
                aria-label={download.label || 'Download case study PDF'}
              >
                <svg class="c-btn__icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Download PDF
              </a>
            )}
          </aside>
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <section class="c-case-related" aria-labelledby="case-related-title">
        <div class="l-container">
          <h2 class="c-case-related__title" id="case-related-title">More work</h2>
          <div class="c-case-related__grid">
            {related.map((item) => (
              <a class="c-case-related__card" href={`/work/${item.slug}`}>
                <span class="c-tag c-tag--accent">{item.type || 'Project'}</span>
                {item.metric && (
                  <span class="c-case-related__metric">
                    {item.metric}
                    <span class="c-case-related__metric-label">{item.metricLabel}</span>
                  </span>
                )}
                <span class="c-case-related__name">{item.title}</span>
                {item.highlight && <span class="c-case-related__copy">{item.highlight}</span>}
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="c-case-cta" aria-labelledby="case-cta-title">
      <div class="l-container">
        <p class="c-case-cta__eyebrow">Work with us</p>
        <h2 class="c-case-cta__title" id="case-cta-title">Need help with something like this?</h2>
        <p class="c-case-cta__lede">
          Need help with A/B testing, Shopify development, or a performance audit?
          Reach out to
          <a href="https://echologyx.com/contact-us" target="_blank" rel="noopener noreferrer">EchoLogyx</a>.
        </p>
        <div class="c-case-cta__actions">
          <a
            href="https://echologyx.com/contact-us"
            class="c-btn c-btn--primary c-btn--lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            Contact EchoLogyx
          </a>
          <a href="/work" class="c-btn c-btn--secondary c-btn--lg">More case studies</a>
        </div>
      </div>
    </section>
  </article>
  <script>
    let headingObserver: IntersectionObserver | null = null;

    function bindCaseToc() {
      headingObserver?.disconnect();
      headingObserver = null;

      const article = document.querySelector('.c-prose--case');
      const links = [...document.querySelectorAll('.c-case-toc__link')];
      if (!article || !links.length) return;

      const headings = links
        .map((link) => {
          const id = (link.getAttribute('href') || '').replace('#', '');
          if (!id) return null;
          return article.querySelector(`#${CSS.escape(id)}`);
        })
        .filter((node): node is HTMLElement => node instanceof HTMLElement);

      const setActive = (id: string) => {
        links.forEach((link) => {
          link.classList.toggle('c-case-toc__link--active', link.getAttribute('href') === `#${id}`);
        });
      };

      headingObserver = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible?.target?.id) setActive(visible.target.id);
        },
        { rootMargin: '-20% 0px -65% 0px', threshold: [0, 0.25, 1] },
      );

      headings.forEach((heading) => headingObserver?.observe(heading));
      if (headings[0]?.id) setActive(headings[0].id);
    }

    document.addEventListener('astro:page-load', bindCaseToc);
    bindCaseToc();
  </script>
  <ImageLightbox />
</BaseLayout>
