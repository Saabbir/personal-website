---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';
import CodeEnhancer from '../components/CodeEnhancer.astro';
import { SITE_ORIGIN, canonicalForPath } from '../utils/seo';
import '../styles/main.scss';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalUrl?: string;
  type?: string;
  publishedTime?: string;
  robots?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Saabbir Hossain — Shopify developer, performance and A/B testing",
  description = "I'm Saabbir, a frontend engineer in Dhaka. I build Shopify storefronts, make them faster, and run A/B tests to find out what actually helps people buy.",
  // 1200x630 card. The old default was a 600x600 headshot, which every
  // summary_large_image share cropped into a square face.
  image = "/images/og/default.png",
  imageAlt,
  canonicalUrl,
  type = "website",
  publishedTime,
  robots,
  schema,
} = Astro.props;

const absoluteImage = new URL(image, SITE_ORIGIN).href;

const resolvedCanonical = canonicalUrl || canonicalForPath(Astro.url.pathname);

const siteTitle = title.includes("Saabbir") ? title : `${title} | Saabbir Hossain`;

// Schema.org Person Structured Data
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://saabbir.com/#person",
  "name": "Saabbir Hossain",
  "jobTitle": "Senior Software Engineer",
  "worksFor": {
    "@type": "Organization",
    "name": "EchoLogyx Ltd"
  },
  "url": "https://saabbir.com",
  "sameAs": [
    "https://github.com/Saabbir",
    "https://www.linkedin.com/in/thesaabbir",
    "https://twitter.com/thesaabbir",
    "https://codepen.io/Saabbir",
    "https://stackoverflow.com/users/5527156/saabbir"
  ],
  "knowsAbout": [
    "Shopify Plus",
    "A/B Testing",
    "Conversion Rate Optimization (CRO)",
    "Optimizely",
    "Frontend Engineering",
    "Vue.js",
    "Astro",
    "Performance Engineering"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Saabbir Hossain",
  "url": SITE_ORIGIN,
  "author": { "@id": `${SITE_ORIGIN}/#person` },
};

const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Favicon & PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/favicon.svg?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0f1d" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:site_name" content="Saabbir Hossain" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt || siteTitle} />
    <meta property="og:locale" content="en_GB" />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={resolvedCanonical} />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={absoluteImage} />
    <meta property="twitter:image:alt" content={imageAlt || siteTitle} />
    <meta name="twitter:site" content="@thesaabbir" />
    <meta name="twitter:creator" content="@thesaabbir" />

    <ViewTransitions />

    <!-- Inline FOUC Prevention Script -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <!-- Schema.org Person JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {pageSchemas.map((entry) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body>
    <a class="u-skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <ChatWidget />
    <CodeEnhancer />
  </body>
</html>
