---
import BaseLayout from './BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import GiscusComments from '../components/GiscusComments.astro';
import Pager from '../components/Pager.astro';
import type { AdjacentItem } from '../utils/adjacent';
import { articleCanonicalUrl, canonicalForPath, toIsoDate } from '../utils/seo';
import { slugifyTag } from '../utils/article';

interface Props {
  title: string;
  description?: string | null;
  createdAt?: string | null;
  tags?: string[];
  slug: string;
  headings?: { depth: number; slug: string; text: string }[];
  readTime?: string;
  prev?: AdjacentItem | null;
  next?: AdjacentItem | null;
  originalSource?: string;
  originalUrl?: string;
}

const { title, description, createdAt, tags = [], slug, headings = [], readTime = "3 min read", prev = null, next = null, originalSource, originalUrl } = Astro.props;
const pageUrl = canonicalForPath(Astro.url.pathname);
const canonicalUrl = articleCanonicalUrl(Astro.url.pathname, originalUrl);
const publishedTime = toIsoDate(createdAt);
const githubEditUrl = `https://github.com/Saabbir/personal-website/edit/main/src/content/articles/${slug}.md`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description || "",
  "url": canonicalUrl,
  "image": "https://saabbir.com/images/cv-headshot.png",
  "author": {
    "@type": "Person",
    "name": "Saabbir Hossain",
    "url": "https://saabbir.com"
  },
  "publisher": {
    "@type": "Person",
    "name": "Saabbir Hossain",
    "url": "https://saabbir.com"
  },
  "datePublished": publishedTime || createdAt || undefined,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  ...(originalUrl ? { isBasedOn: originalUrl } : {}),
};
---

<BaseLayout title={title} description={description || undefined} type="article" canonicalUrl={canonicalUrl} publishedTime={publishedTime}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  
  <article class="l-section">
    <div class="l-container l-container--narrow">
      <!-- Article Header -->
      <header class="u-mb-32">
        <div style="display:flex; align-items:center; gap:0.75rem; font-size:0.85rem; color:var(--color-text-dim); margin-bottom:1rem;">
          {createdAt && <span>{createdAt}</span>}
          <span>•</span>
          <span style="color:var(--color-accent); font-weight:600;">{readTime}</span>
        </div>

        <h1 class="u-mb-16" style="font-size: clamp(2.25rem, 4vw, 3.5rem); font-weight: 800; line-height: 1.2;">
          {title}
        </h1>

        {description && (
          <p class="u-text-muted" style="font-size: 1.2rem; line-height: 1.6; margin-bottom: 1.5rem;">
            {description}
          </p>
        )}

        {originalSource && originalUrl && (
          <p class="u-text-muted" style="font-size: 0.9rem; margin-bottom: 1.5rem;">
            Originally published on{' '}
            <a href={originalUrl} target="_blank" rel="noopener noreferrer" style="color:var(--color-accent); font-weight:600;">
              {originalSource}
            </a>
          </p>
        )}

        {tags.length > 0 && (
          <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom: 1.5rem;">
            {tags.map((tag) => (
              <a href={`/blog/tag/${slugifyTag(tag)}`} class="c-tag">
                #{tag}
              </a>
            ))}
          </div>
        )}

        <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; padding-top:1rem; border-top:1px solid var(--color-border-subtle); font-size:0.85rem;">
          <a
            href={githubEditUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="u-text-muted"
            style="display:inline-flex; align-items:center; gap:0.4rem;"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
            Edit on GitHub
          </a>
        </div>
      </header>

      <!-- Table of Contents -->
      {headings.length > 0 && (
        <nav class="c-toc" aria-label="Table of contents">
          <div class="c-toc__title">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
            Table of Contents
          </div>
          <ul class="c-toc__list">
            {headings.map((h) => (
              <li class={`c-toc__item c-toc__item--depth-${h.depth}`}>
                <a href={`#${h.slug}`} class="c-toc__link">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <!-- Post Body -->
      <div class="c-prose">
        <slot />
      </div>

      <!-- Social Share -->
      <ShareButtons title={title} url={pageUrl} />

      <div class="c-card c-card--glass c-author">
        <img
          class="c-author__photo"
          src="/images/cv-headshot.png"
          alt="Saabbir Hossain"
          width="80"
          height="80"
        />
        <div class="c-author__body">
          <h4 class="c-author__name">Written by Saabbir Hossain</h4>
          <p class="c-author__bio">
            Sr. Software Engineer at EchoLogyx Ltd, CRO-driven Shopify Plus Developer and Optimizely Certified A/B Testing Expert based in Bangladesh.
          </p>
        </div>
      </div>

      <!-- Giscus GitHub Comments -->
      <GiscusComments />

      <Pager collection="blog" prev={prev} next={next} />
    </div>
  </article>
</BaseLayout>
