---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_ORIGIN } from '../../utils/seo';
---

<BaseLayout
  title="This page moved"
  description="This page is no longer published. Writing and notes live on the home page."
  robots="noindex, nofollow"
  canonicalUrl={`${SITE_ORIGIN}/`}
>
  <meta slot="head" http-equiv="refresh" content="0;url=/" />
  <section class="l-section">
    <div class="l-container l-container--narrow u-text-center">
      <h1 class="l-section__title">This page moved</h1>
      <p class="u-text-muted u-mt-16">
        Head to the <a href="/">home page</a> or <a href="/blog">Writing</a>.
      </p>
    </div>
  </section>
  <script is:inline>
    window.location.replace('/');
  </script>
</BaseLayout>
