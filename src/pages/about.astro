---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

const certifications = [
  {
    title: 'Optimizely Certified Experimentation Web Platform Expert',
    issuer: 'Optimizely',
    issued: 'Nov 2023',
    skills: 'CRO Management, Cascading Style Sheets (CSS), A/B Testing, Web Experimentation',
    badge: 'Expert'
  },
  {
    title: 'Optimizely Certified Experimentation Practitioner',
    issuer: 'Optimizely',
    issued: 'Jan 2022',
    skills: 'A/B Testing, Experiment Design, Conversion Rate Optimization',
    badge: 'Practitioner'
  },
  {
    title: 'Google Analytics for Beginners',
    issuer: 'Google',
    issued: 'Aug 2021',
    skills: 'GA4 Event Tracking, Data Analytics, eCommerce Reporting',
    badge: 'Analytics'
  }
];

const timelineEvents = [
  {
    period: '04/2021 — Present',
    title: 'Senior Software Engineer (Shopify & CRO Lead)',
    company: 'EchoLogyx Ltd (Dhanmondi, Dhaka)',
    description: 'Leading the Shopify frontend team, mentoring developers, and contributing to hiring efforts. Specialized in developing premium Shopify stores for high-growth brands (Wax London, Raab Vital) using Liquid, JavaScript, SCSS, and Alpine.js, while conducting site audits to improve performance and Core Web Vitals. Delivered 200+ A/B test experiments using Optimizely, AB Tasty, Adobe Target, VWO, and Convert.'
  },
  {
    period: '01/2018 — 04/2021',
    title: 'Senior Frontend Engineer',
    company: 'Inspectiv (Los Angeles, CA)',
    description: 'Led frontend development for an appsec SaaS security dashboard utilizing React.js, Vue.js, and Vuex/Redux. Built reusable component libraries, engineered custom WordPress themes, and developed fast static sites with Gatsby, Eleventy, and Nuxt.js.'
  },
  {
    period: '2016 — 2018',
    title: 'Frontend Developer (Freelance)',
    company: 'Upwork & ThemeForest',
    description: 'Delivered 50+ pixel-perfect responsive websites (Figma/PSD to HTML & WordPress) and email templates. Created custom scalable SCSS architectures and utility-first CSS systems.'
  }
];

const resumeUrl = "/Saabbir_Hossain_Senior_Frontend_Engineer_8_Years_Resume_1_v7.pdf";
---

<BaseLayout title="About Saabbir Hossain" description="About Saabbir Hossain — Senior Software Engineer, Shopify Plus Developer, and Optimizely Certified CRO Specialist.">
  <section class="l-section">
    <div class="l-container l-container--narrow">
      <div class="u-mb-32">
        <div class="l-section__subtitle">About Me</div>
        <h1 class="u-mb-24" style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800;">
          Hi, I'm Saabbir Hossain.
        </h1>

        <div class="c-prose">
          <p>
            As a <strong>Senior Software Engineer at EchoLogyx Ltd</strong> with over two years in this role, I lead the Shopify frontend team, mentor developers, and contribute to hiring efforts. I specialize in developing premium Shopify stores for high-growth brands using <strong>Liquid, JavaScript, SCSS, and Alpine.js</strong>, while conducting site audits to improve performance and Core Web Vitals.
          </p>

          <p>
            With <strong>more than eight years of experience</strong> in frontend development, I have honed my expertise in A/B testing, CRO strategy, and building responsive websites. My work at EchoLogyx has allowed me to apply tools like <strong>Optimizely, AB Tasty, and VWO</strong> to create dynamic shopping experiences that enhance user engagement and drive growth. My commitment to clean code, scalability, and impactful collaboration ensures the delivery of high-quality digital solutions.
          </p>
        </div>

        <div class="u-mt-32" style="display:flex; gap:1rem; flex-wrap:wrap;">
          <a href="/contact" class="c-btn c-btn--primary c-btn--lg">Get in Touch</a>
          <a href={resumeUrl} download="Saabbir_Hossain_Resume.pdf" class="c-btn c-btn--secondary c-btn--lg">
            Download Resume (PDF)
          </a>
        </div>
      </div>
    </div>

    <!-- Location & Photo Showcase -->
    <div class="l-container">
      <figure style="margin: 3rem 0;">
        <div class="c-card c-card--glass" style="padding:0.75rem; overflow:hidden;">
          <img
            src="/images/remarki-fall.jpg"
            alt="Saabbir Hossain on Remarki Fall, Thanchi, Bandarban"
            width="1200"
            height="901"
            style="border-radius:12px; width:100%; height:auto; object-fit:cover;"
          />
        </div>
        <figcaption style="font-size:0.9rem; color:var(--color-text-dim); text-align:center; margin-top:1rem;">
          Exploring Remarki Fall, Thanchi, Bandarban, Bangladesh.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="l-section l-section--alt">
    <div class="l-container l-container--narrow">
      <div class="l-section__header u-text-center">
        <div class="l-section__subtitle">Verified Credentials</div>
        <h2 class="l-section__title">Licenses & Certifications</h2>
      </div>

      <div style="display:flex; flex-direction:column; gap:1.25rem;">
        {certifications.map((cert) => (
          <div class="c-card c-card--glass" style="display:flex; flex-direction:row; align-items:flex-start; gap:1.25rem;">
            <div style="width:48px; height:48px; min-width:48px; border-radius:12px; background:rgba(0,229,153,0.1); border:1px solid rgba(0,229,153,0.25); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15l-2 5l9-11h-7l2-5l-9 11h7z"></path></svg>
            </div>
            <div>
              <h3 style="font-size:1.15rem; font-weight:700; color:var(--color-text-main); margin-bottom:0.2rem;">
                {cert.title}
              </h3>
              <div style="font-size:0.9rem; color:var(--color-accent); font-weight:600; margin-bottom:0.25rem;">
                {cert.issuer} • <span style="color:var(--color-text-dim); font-weight:400;">Issued {cert.issued}</span>
              </div>
              <div style="font-size:0.85rem; color:var(--color-text-muted); margin-bottom:0.75rem;">
                <strong>Skills:</strong> {cert.skills}
              </div>
              <span class="c-tag c-tag--accent">{cert.badge}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="l-section l-section--surface">
    <div class="l-container l-container--narrow">
      <div class="l-section__header u-text-center">
        <div class="l-section__subtitle">Career Progression</div>
        <h2 class="l-section__title">Work Experience</h2>
      </div>

      <div class="c-timeline">
        {timelineEvents.map((item) => (
          <div class="c-timeline__item">
            <div class="c-timeline__point"></div>
            <div class="c-timeline__meta">{item.period}</div>
            <h3 class="c-timeline__title">{item.title}</h3>
            <div class="c-timeline__subtitle">{item.company}</div>
            <p class="c-timeline__desc">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="l-section">
    <div class="l-container l-container--narrow">
      <div class="l-section__header u-text-center">
        <div class="l-section__subtitle">Academic Background</div>
        <h2 class="l-section__title">Education</h2>
      </div>

      <div class="c-card c-card--glass">
        <h3 style="font-size:1.25rem; font-weight:700; color:var(--color-text-main); margin-bottom:0.3rem;">
          Bachelor of Science in Computer Science and Engineering
        </h3>
        <div style="font-size:0.95rem; color:var(--color-accent); font-weight:600; margin-bottom:0.5rem;">
          Institute of Science, Trade and Technology (ISTT)
        </div>
        <div style="font-size:0.85rem; color:var(--color-text-dim);">
          2014 — 2018 | Dhaka, Bangladesh
        </div>
      </div>
    </div>
  </section>

  <section class="l-section l-section--alt">
    <div class="l-container l-container--narrow">
      <div class="u-text-center u-mb-32">
        <div class="l-section__subtitle">Contact</div>
        <h2 class="l-section__title">Send a Message</h2>
      </div>

      <div class="c-card c-card--glass">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
