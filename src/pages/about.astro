---
import BaseLayout from '../layouts/BaseLayout.astro';

const certifications = [
  {
    title: 'Optimizely Certified Experimentation Web Platform Expert',
    issuer: 'Optimizely',
    issued: 'Nov 2023',
    badge: 'Expert'
  },
  {
    title: 'Optimizely Certified Experimentation Practitioner',
    issuer: 'Optimizely',
    issued: 'Jan 2022',
    badge: 'Practitioner'
  },
  {
    title: 'Google Analytics for Beginners',
    issuer: 'Google',
    issued: 'Aug 2021',
    badge: 'Analytics'
  }
];

const timelineEvents = [
  {
    period: '2021 — now',
    title: 'Senior Software Engineer',
    company: 'EchoLogyx, Dhaka',
    description: "I lead the Shopify frontend team, which means as much mentoring and interviewing as building. Most of the work is themes for brands like Wax London and Raab Vital, plus the audits that come after — why is this page slow, why is the header jumping, why did that test not move anything. Somewhere past 200 A/B tests by now, across Optimizely, AB Tasty, Adobe Target, VWO and Convert."
  },
  {
    period: '2018 — 2021',
    title: 'Senior Frontend Engineer',
    company: 'Inspectiv, Los Angeles',
    description: "A security dashboard in React and Vue, built from Dhaka for a team in California. This is where I learned to work across a twelve-hour gap and write things down properly, because you can't tap someone on the shoulder at 3am their time. Also a lot of WordPress themes and static sites — Gatsby, Eleventy, Nuxt."
  },
  {
    period: '2016 — 2018',
    title: 'Freelance frontend developer',
    company: 'Upwork, ThemeForest, CoderPixel',
    description: "Designs in, HTML and CSS out. Somewhere around 50 sites, plus email templates, which teach you humility fast. This is where I got obsessive about CSS architecture, mostly because I kept having to go back into my own stylesheets and couldn't find anything."
  }
];

const projects = [
  {
    name: 'ios-quirks',
    desc: "A running list of the ways iOS Safari differs from every other browser, with fixes I've actually tested. Started because I kept solving the same problems and forgetting how.",
    url: 'https://ios-quirks.netlify.app',
    github: 'https://github.com/Saabbir/ios-quirks'
  },
  {
    name: 'shopify-tab-extension',
    desc: 'A Chrome extension that replaces the new-tab page with recent Shopify and web development videos. Built for myself, then left it public.',
    url: 'https://github.com/Saabbir/shopify-tab-extension',
    github: 'https://github.com/Saabbir/shopify-tab-extension'
  },
  {
    name: 'school-finder-bangladesh',
    desc: 'Find schools near you in Dhaka. A small thing, but the kind of problem that is genuinely annoying if you live here.',
    url: 'https://school-finder-bangladesh.vercel.app/',
    github: 'https://github.com/Saabbir/school-finder-bangladesh'
  }
];

const toolGroups = [
  { name: 'Shopify', tools: 'Liquid, theme architecture, Shopify CLI, Storefront API, metafields, Alpine.js' },
  { name: 'Testing', tools: 'Convert, Optimizely, VWO, Adobe Target, AB Tasty, Kameleoon' },
  { name: 'Frontend', tools: 'JavaScript, React, Vue, Nuxt, Astro, SCSS' },
  { name: 'Analytics', tools: 'GA4, Google Tag Manager, Looker Studio' }
];

const resumeUrl = "/Saabbir_Hossain_Senior_Frontend_Engineer_8_Years_Resume_1_v7.pdf";
---

<BaseLayout
  title="About Saabbir Hossain"
  description="I'm Saabbir — a frontend engineer in Dhaka. I build Shopify storefronts, make them faster, and run A/B tests. Here's how I got here and what I work on."
  image="/images/og/about.png"
>
  <section class="l-section">
    <div class="l-container l-container--narrow">
      <h1 class="c-page-title">Hi, I'm Saabbir.</h1>

      <div class="c-prose">
        <p class="c-prose__lede">
          I'm a frontend engineer in Dhaka. I build Shopify storefronts, make them faster, and run A/B tests to find out whether the things we believe about a store are actually true.
        </p>

        <h2>How I got here</h2>

        <p>
          I started taking paid work in 2016, while I was still at university studying computer science. It was the usual freelance route — Upwork and ThemeForest, turning PSDs and Figma files into HTML and CSS. Around fifty sites over two years, plus a stretch of email templates, which is a fast way to learn that the web you think you're building for is not the only web there is.
        </p>

        <p>
          That work taught me CSS properly, mostly out of self-defence. When you build your fortieth site you start noticing that the problem isn't writing the styles, it's finding them again three months later. I still write CSS like someone who expects to come back to it.
        </p>

        <p>
          In 2018 I joined Inspectiv in Los Angeles, from Dhaka, and spent three years on a security dashboard in React and Vue. Different problem entirely — state, data, and a twelve-hour time difference that meant if I didn't explain myself clearly in writing, nobody could unblock me until the next day.
        </p>

        <p>
          Then in 2021 I moved to EchoLogyx and into Shopify, which is where I've been since. Themes first, then performance, then testing.
        </p>

        {/*
          TODO(saabbir): one paragraph here on how you ended up in CRO and
          A/B testing specifically. Was it assigned to you, did you go looking
          for it, was there a particular project? This is the hinge of the
          whole story and it's the one bit I can't write for you — I'd only
          be guessing. Two or three sentences is plenty.
        */}

        <p>
          That's the short version of eight years: designs to markup, then applications, then stores, then measuring whether any of it worked.
        </p>

        <h2>What I work on now</h2>

        <p>
          Mostly Shopify Plus stores, where a small change to a product page is never actually small. Move one thing and you've touched page speed, the conversion funnel, the analytics, and whether the client's team can still edit it in the theme editor — all at once. That's the part I find genuinely interesting.
        </p>

        <p>
          The other half is experiments. Setting them up, but more importantly deciding what's worth testing and reading the results without kidding yourself. Most tests don't win. A test programme where everything wins is a test programme that's measuring itself wrong. You can see how I write these up over on <a href="/work">my case studies</a> — including the numbers that didn't clear the confidence bar.
        </p>

        {/*
          TODO(saabbir): two sections that would make this page much better,
          and that only you can write. Drop them in here.

          <h2>What I got wrong</h2>
          One or two real ones, told plainly. Structure that works:
            - what I originally did
            - what went wrong
            - what I changed
            - what I'd do differently now
          Candidates from your own work — pick whichever is true:
            - the Convert setup with two purchase goals reporting different
              lifts: how did you find that, and what do you do differently now?
            - a Shopify theme decision you had to undo later
            - something you shipped that made a page slower

          <h2>What I'm learning right now</h2>
          Two or three sentences. What are you actually reading or building
          at the moment, and what don't you understand about it yet?
          The "don't understand yet" half is the part people remember.
        */}
      </div>

      <div class="c-about__actions">
        <a href="/work" class="c-btn c-btn--primary c-btn--lg">See my work</a>
        <a href={resumeUrl} download="Saabbir_Hossain_Resume.pdf" class="c-btn c-btn--secondary c-btn--lg">
          Download my CV (PDF)
        </a>
      </div>
    </div>

    <div class="l-container">
      <figure class="c-about__figure">
        <div class="c-card c-card--glass c-about__figure-frame">
          <img
            src="/images/remarki-fall.jpg"
            alt="Saabbir Hossain sitting on rocks at Remarki Fall in Thanchi, Bandarban"
            width="1200"
            height="901"
            loading="lazy"
            decoding="async"
          />
        </div>
        {/*
          TODO(saabbir): replace this caption with something that sounds like
          you. Where is it, when did you go, and why does it matter to you?
          One or two sentences. This is the most human spot on the whole site
          and right now it reads like a photo credit.
        */}
        <figcaption>Remarki Fall, Thanchi, Bandarban.</figcaption>
      </figure>
    </div>
  </section>

  <section class="l-section l-section--alt">
    <div class="l-container l-container--narrow">
      <div class="l-section__header">
        <h2 class="l-section__title">Where I've worked</h2>
      </div>

      <div class="c-timeline">
        {timelineEvents.map((item) => (
          <div class="c-timeline__item">
            <div class="c-timeline__point"></div>
            <div class="c-timeline__meta">{item.period}</div>
            <h3 class="c-timeline__title">{item.title}</h3>
            <div class="c-timeline__subtitle">{item.company}</div>
            <p class="c-timeline__desc">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="l-section">
    <div class="l-container l-container--narrow">
      <div class="l-section__header">
        <h2 class="l-section__title">Tools I reach for</h2>
        <p class="u-text-muted l-section__lede">
          Not a ranking, and not everything I've touched — just what I actually use most weeks.
        </p>
      </div>

      <dl class="c-toollist">
        {toolGroups.map((group) => (
          <div class="c-toollist__row">
            <dt class="c-toollist__name">{group.name}</dt>
            <dd class="c-toollist__items">{group.tools}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="l-section l-section--alt">
    <div class="l-container l-container--narrow">
      <div class="l-section__header">
        <h2 class="l-section__title">Things I built for myself</h2>
        <p class="u-text-muted l-section__lede">
          Small projects, mostly scratching my own itch. They're on GitHub if they're useful to you too.
        </p>
      </div>

      <div class="l-grid l-grid--2col">
        {projects.map((repo) => (
          <div class="c-card c-card--glass">
            <h3 class="c-card__title">
              <a href={repo.url} target="_blank" rel="noopener noreferrer">{repo.name}</a>
            </h3>
            <p class="c-card__body">{repo.desc}</p>
            <div class="c-card__footer">
              <a href={repo.github} target="_blank" rel="noopener noreferrer" class="c-btn c-btn--ghost c-btn--sm">
                Code ↗
              </a>
            </div>
          </div>
        ))}
      </div>

      <p class="u-text-muted c-about__more">
        <a href="https://github.com/Saabbir?tab=repositories" target="_blank" rel="noopener noreferrer">
          The rest of my GitHub ↗
        </a>
      </p>
    </div>
  </section>

  <section class="l-section">
    <div class="l-container l-container--narrow">
      <div class="l-section__header">
        <h2 class="l-section__title">Certifications and education</h2>
      </div>

      <ul class="c-credlist">
        {certifications.map((cert) => (
          <li class="c-credlist__item">
            <div class="c-credlist__body">
              <h3 class="c-credlist__title">{cert.title}</h3>
              <p class="c-credlist__meta">{cert.issuer} · {cert.issued}</p>
            </div>
            <span class="c-tag c-tag--accent">{cert.badge}</span>
          </li>
        ))}
        <li class="c-credlist__item">
          <div class="c-credlist__body">
            <h3 class="c-credlist__title">BSc in Computer Science and Engineering</h3>
            <p class="c-credlist__meta">
              Institute of Science, Trade and Technology, Dhaka · 2014 — 2018
            </p>
          </div>
          <span class="c-tag">Degree</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="l-section l-section--alt">
    <div class="l-container l-container--narrow">
      <h2 class="l-section__title">Want to talk?</h2>
      <p class="u-text-muted l-section__lede u-mb-24">
        If you've got a Shopify build, a page that's slow, or a test you're not sure how to run, I'd like to hear about it.
      </p>
      <a href="/contact" class="c-btn c-btn--primary c-btn--lg">Get in touch</a>
    </div>
  </section>
</BaseLayout>
