---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found" description="The page you are looking for does not exist or has been moved." robots="noindex, nofollow">
  <section class="l-section" style="min-height:70vh; display:flex; align-items:center;">
    <div class="l-container l-container--narrow u-text-center">
      <div style="font-size: clamp(5rem, 12vw, 9rem); font-weight: 800; font-family:var(--font-family-heading); background: linear-gradient(135deg, var(--color-accent), var(--color-accent-cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; line-height: 1;">
        404
      </div>

      <h1 class="u-mb-16" style="font-size:2rem; font-weight:700;">There's nothing here</h1>

      <p class="u-text-muted u-mb-32" style="font-size:1.1rem; max-width:500px; margin-left:auto; margin-right:auto;">
        This page either moved or never existed. If you followed a link to get
        here, <a href="/contact">tell me where from</a> and I'll fix it.
      </p>

      <div style="display:flex; justify-content:center; gap:1rem; flex-wrap:wrap;">
        <a href="/work" class="c-btn c-btn--primary c-btn--lg">See my work</a>
        <a href="/blog" class="c-btn c-btn--secondary c-btn--lg">Read something instead</a>
      </div>
    </div>
  </section>
</BaseLayout>
