---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDisplayDate } from '../../utils/seo';

const allSnippets = await getCollection('snippets');
const publishedSnippets = allSnippets.filter((s) => s.data.publish !== false);
---

<BaseLayout
  title="Snippets"
  description="Small frontend fixes I keep needing — mostly CSS and browser quirks, saved here so I stop re-solving them."
>
  <section class="l-section">
    <div class="l-container">
      <div class="l-section__header u-text-center" style="max-width:700px; margin-left:auto; margin-right:auto;">
        <h1 class="l-section__title">Snippets</h1>
        <p class="u-text-muted u-mt-16">
          Small fixes I keep needing. Saved here mostly so I stop solving the
          same browser quirk twice.
        </p>
      </div>

      <div class="l-grid l-grid--3col l-grid--cards">
        {publishedSnippets.map((snippet) => (
          <article class="c-card c-card--glass c-card--hoverable c-card--article">
            <div class="c-card__meta">
              {snippet.data.createdAt && <span>{formatDisplayDate(snippet.data.createdAt)}</span>}
              <span>•</span>
              <span style="color:var(--color-accent); font-weight:600;">Snippet</span>
            </div>

            <div class="c-card__main">
              <h2 class="c-card__title">
                <a href={`/snippets/${snippet.slug}`}>{snippet.data.title}</a>
              </h2>

              <div class="c-card__body">
                {snippet.data.description}
              </div>
            </div>

            <div class="c-card__footer">
              <div class="c-card__tags">
                {snippet.data.tags?.map((tag) => (
                  <span class="c-tag">#{tag}</span>
                ))}
              </div>
              <a href={`/snippets/${snippet.slug}`} class="c-btn c-btn--ghost c-btn--sm">
                View Snippet →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
