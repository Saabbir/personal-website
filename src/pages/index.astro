---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getCollection } from 'astro:content';
import { articleHref, articleLinkRel, isExternalArticle } from '../utils/article';
import { contentDateValue, formatDisplayDate, toIsoDate } from '../utils/seo';

const allArticles = await getCollection('articles');
const publishedArticles = allArticles
  .filter(a => a.data.publish !== false)
  .sort((a, b) => contentDateValue(b.data.createdAt) - contentDateValue(a.data.createdAt));
const recentArticles = publishedArticles.slice(0, 3);
const featuredArticle = publishedArticles[0];

const allSnippets = await getCollection('snippets');
const recentSnippets = allSnippets
  .filter((s) => s.data.publish !== false)
  .sort((a, b) => contentDateValue(b.data.createdAt) - contentDateValue(a.data.createdAt))
  .slice(0, 3);

const resumeUrl = "/Saabbir_Hossain_Senior_Frontend_Engineer_8_Years_Resume_1_v7.pdf";

const testimonials = [
  {
    name: 'Avery',
    role: 'React frontend for a financial planning app',
    initials: 'A',
    date: 'Upwork review · April – June 2021',
    quote: 'Saabbir is an excellent and trustworthy frontend developer who I plan to continue to use for frontend projects in the future. Thanks for your great work!',
    rating: 5,
  },
  {
    name: 'Joseph Melika',
    role: 'Founder & CEO at Discloze',
    initials: 'JM',
    date: 'LinkedIn recommendation · December 2019',
    quote: "Saabbir has been an integral part of our development operations. Despite being remote with very different timezone, he's been very capable of adapting and integrating into our US-based operations. Very creative, prompt, and skilled.",
    rating: 5,
  },
];

const week = [
  {
    title: 'Shopify themes',
    description: "Built from scratch, or working inside a theme someone else wrote. Most of my time goes on the parts that are easy to get wrong: the product page, the cart, and whatever is making the first screen slow.",
    tools: ['Liquid', 'Web Components', 'Shopify CLI', 'Claude Code'],
  },
  {
    title: 'A/B testing',
    description: "I set up tests that answer one question at a time, then read the results honestly — including the ones that come back flat.",
    tools: ['Convert', 'Optimizely', 'AB Tasty'],
  },
  {
    title: 'Making pages faster',
    description: "This starts with measuring the page properly instead of guessing. Then it's getting the hero image on screen sooner, stopping the header from jumping, and finding which third-party script is costing two seconds.",
    tools: ['WebPageTest', 'DebugBear', 'LCP', 'INP'],
  },
  {
    title: 'Tracking and analytics',
    description: "Set the tracking up so the numbers mean something. If you can't trust the funnel, there's no point testing against it.",
    tools: ['GA4', 'GTM', 'Shopify Analytics'],
  },
];

const projects = [
  {
    name: 'ios-quirks',
    desc: "A running list of the ways iOS Safari differs from every other browser, with fixes I've actually tested. Started because I kept solving the same problems and forgetting how.",
    url: 'https://ios-quirks.netlify.app',
    github: 'https://github.com/Saabbir/ios-quirks'
  },
  {
    name: 'shopify-tab-extension',
    desc: 'A Chrome extension that replaces the new-tab page with recent Shopify and web development videos. Built for myself, then left it public.',
    url: 'https://github.com/Saabbir/shopify-tab-extension',
    github: 'https://github.com/Saabbir/shopify-tab-extension'
  },
  {
    name: 'school-finder-bangladesh',
    desc: 'Find schools near you in Dhaka. A small thing, but the kind of problem that is genuinely annoying if you live here.',
    url: 'https://school-finder-bangladesh.vercel.app/',
    github: 'https://github.com/Saabbir/school-finder-bangladesh'
  }
];
---

<BaseLayout>
  <section class="l-section l-section--hero">
    <div class="l-container">
      <div class="c-hero">
        <div class="c-hero__content">
          <h1 class="c-hero__title">
            I build Shopify storefronts, and I test what <span class="c-hero__title-highlight">actually works</span>.
          </h1>

          <p class="c-hero__bio">
            I'm <strong>Saabbir</strong>. I've been building for the web since 2016. These days most of my work is Shopify themes, frontend performance, and A/B testing. I'm a senior engineer at <strong>EchoLogyx</strong> in Dhaka.
          </p>

          <p class="c-hero__bio">
            Most of what I know came from building things, breaking them, and working out why they broke.
          </p>

          <div class="c-hero__actions">
            <div class="c-hero__actions-row">
              <a href="/blog" class="c-btn c-btn--primary c-btn--lg">
                Read the writing
              </a>
              <a href="/about" class="c-btn c-btn--secondary c-btn--lg">
                About me
              </a>
            </div>
            <a
              href={resumeUrl}
              download="Saabbir_Hossain_Resume.pdf"
              class="c-btn c-btn--ghost"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              Download my CV (PDF)
            </a>
          </div>
        </div>

        {featuredArticle && (
          <aside class="c-hero__feature" aria-labelledby="hero-feature-title">
            <p class="c-hero__feature-label">Latest writing</p>
            <p class="c-hero__feature-post" id="hero-feature-title">{featuredArticle.data.title}</p>
            {featuredArticle.data.createdAt && (
              <p class="c-hero__feature-meta">
                <time datetime={toIsoDate(featuredArticle.data.createdAt)}>
                  {formatDisplayDate(featuredArticle.data.createdAt)}
                </time>
                {isExternalArticle(featuredArticle) && (
                  <>
                    <span aria-hidden="true"> · </span>
                    <span>{featuredArticle.data.externalSource || 'External'}</span>
                  </>
                )}
              </p>
            )}
            {featuredArticle.data.description && (
              <p class="c-hero__feature-copy">{featuredArticle.data.description}</p>
            )}
            <a
              href={articleHref(featuredArticle)}
              class="c-hero__feature-link"
              {...articleLinkRel(featuredArticle)}
            >
              {isExternalArticle(featuredArticle)
                ? `Read on ${featuredArticle.data.externalSource || 'EchoLogyx'} →`
                : 'Read it →'}
            </a>
          </aside>
        )}
      </div>
    </div>
  </section>

  <section class="l-section l-section--alt">
    <div class="l-container">
      <div class="l-section__header l-section__header--split">
        <div>
          <h2 class="l-section__title">Writing</h2>
          <p class="u-text-muted l-section__lede">
            Posts about Shopify, A/B testing, analytics, and CSS — written down after I had to work it out.
          </p>
        </div>
        <a href="/blog" class="c-btn c-btn--ghost">Everything I've written →</a>
      </div>

      <div class="l-grid l-grid--3col l-grid--cards">
        {recentArticles.map((article) => (
          <article class="c-card c-card--glass c-card--hoverable c-card--article">
            <div class="c-card__meta">
              {article.data.createdAt && <span>{formatDisplayDate(article.data.createdAt)}</span>}
              <span>•</span>
              <span class="c-card__meta-source">
                {article.data.externalSource || (isExternalArticle(article) ? 'External' : 'Blog')}
              </span>
            </div>

            <div class="c-card__main">
              <h3 class="c-card__title">
                <a href={articleHref(article)} {...articleLinkRel(article)}>{article.data.title}</a>
              </h3>

              <div class="c-card__body">
                {article.data.description}
              </div>
            </div>

            <div class="c-card__footer">
              <div class="c-card__tags">
                {article.data.tags?.slice(0, 3).map((tag) => (
                  <span class="c-tag">#{tag}</span>
                ))}
              </div>
              <a href={articleHref(article)} class="c-btn c-btn--ghost c-btn--sm" {...articleLinkRel(article)}>
                {isExternalArticle(article) ? `Read on ${article.data.externalSource || 'EchoLogyx'} ↗` : 'Read →'}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="l-section">
    <div class="l-container">
      <div class="l-section__header l-section__header--split">
        <div>
          <h2 class="l-section__title">Snippets</h2>
          <p class="u-text-muted l-section__lede">
            Short bits of code I look up when the same problem comes back.
          </p>
        </div>
        <a href="/snippets" class="c-btn c-btn--ghost">All snippets →</a>
      </div>

      <div class="l-grid l-grid--3col l-grid--cards">
        {recentSnippets.map((snippet) => (
          <article class="c-card c-card--glass c-card--hoverable c-card--article">
            <div class="c-card__meta">
              {snippet.data.createdAt && <span>{formatDisplayDate(snippet.data.createdAt)}</span>}
              <span>•</span>
              <span class="c-card__meta-source">Snippet</span>
            </div>

            <div class="c-card__main">
              <h3 class="c-card__title">
                <a href={`/snippets/${snippet.slug}`}>{snippet.data.title}</a>
              </h3>

              <div class="c-card__body">
                {snippet.data.description}
              </div>
            </div>

            <div class="c-card__footer">
              <div class="c-card__tags">
                {snippet.data.tags?.slice(0, 3).map((tag) => (
                  <span class="c-tag">#{tag}</span>
                ))}
              </div>
              <a href={`/snippets/${snippet.slug}`} class="c-btn c-btn--ghost c-btn--sm">
                View snippet →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="l-section l-section--alt">
    <div class="l-container">
      <div class="l-section__header">
        <h2 class="l-section__title">What I do</h2>
        <p class="u-text-muted l-section__lede">
          Most of a week is Shopify themes, A/B tests, making pages faster, and getting the tracking right.
        </p>
      </div>

      <div class="l-grid l-grid--2col">
        {week.map((item) => (
          <article class="c-card c-card--glass c-service-card">
            <h3 class="c-card__title">{item.title}</h3>
            <p class="c-card__body">{item.description}</p>
            <div class="c-card__tags">
              {item.tools.map((tool) => (
                <span class="c-tag">{tool}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="l-section">
    <div class="l-container">
      <div class="l-section__header">
        <h2 class="l-section__title">Built for myself</h2>
        <p class="u-text-muted l-section__lede">
          Personal projects I needed, then left on GitHub.
        </p>
      </div>

      <div class="l-grid l-grid--3col">
        {projects.map((repo) => (
          <div class="c-card c-card--glass">
            <h3 class="c-card__title">
              <a href={repo.url} target="_blank" rel="noopener noreferrer">{repo.name}</a>
            </h3>
            <p class="c-card__body">{repo.desc}</p>
            <div class="c-card__footer">
              <a href={repo.github} target="_blank" rel="noopener noreferrer" class="c-btn c-btn--ghost c-btn--sm">
                Code ↗
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="l-section l-section--alt">
    <div class="l-container">
      <div class="l-section__header">
        <h2 class="l-section__title">From people I worked with</h2>
        <p class="u-text-muted l-section__lede">
          It's nice to see good feedback on the work.
        </p>
      </div>

      <div class="l-grid l-grid--2col">
        {testimonials.map((t) => (
          <div class="c-card c-card--glass c-testimonial">
            <div class="c-testimonial__rating" role="img" aria-label={`${t.rating} out of 5`}>
              {Array.from({ length: t.rating }).map(() => (
                <span aria-hidden="true">★</span>
              ))}
            </div>
            <p class="c-testimonial__quote">{t.quote}</p>

            <div class="c-testimonial__author">
              <div class="c-testimonial__author-avatar" aria-hidden="true">{t.initials}</div>
              <div class="c-testimonial__author-info">
                <div class="c-testimonial__author-name">{t.name}</div>
                <div class="c-testimonial__author-role">{t.role}</div>
                <div class="c-testimonial__author-date">{t.date}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="l-section">
    <div class="l-container l-container--narrow">
      <div class="u-mb-32">
        <h2 class="l-section__title">Get in touch</h2>
        <p class="u-text-muted">
          A question about a post, or a hello. I usually reply within a day or two.
        </p>
      </div>

      <div class="c-card c-card--glass">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
