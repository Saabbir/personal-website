---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getCollection } from 'astro:content';
import { articleHref, articleLinkRel, isExternalArticle } from '../utils/article';
import { contentDateValue, formatDisplayDate, formatWorkDate } from '../utils/seo';
import { workThumb } from '../utils/work';

const allArticles = await getCollection('articles');
const recentArticles = allArticles
  .filter(a => a.data.publish !== false)
  .sort((a, b) => contentDateValue(b.data.createdAt) - contentDateValue(a.data.createdAt))
  .slice(0, 3);

const allWork = await getCollection('work');
const publishedWork = allWork
  .filter((w) => w.data.publish !== false)
  .sort((a, b) => {
    const featuredDiff = Number(b.data.featured) - Number(a.data.featured);
    if (featuredDiff !== 0) return featuredDiff;
    return contentDateValue(b.data.createdAt) - contentDateValue(a.data.createdAt);
  });

// Show one study per client before repeating a client, so the homepage
// doesn't read like a single-client portfolio. Backfill to three.
const byClient = new Map<string, typeof publishedWork>();
for (const item of publishedWork) {
  const key = item.data.client || item.slug;
  if (!byClient.has(key)) byClient.set(key, []);
  byClient.get(key)!.push(item);
}
const onePerClient = [...byClient.values()].map((list) => list[0]);
const backfill = publishedWork.filter((item) => !onePerClient.includes(item));
const featuredWork = [...onePerClient, ...backfill].slice(0, 3);

const featuredHighlight = featuredWork[0];
const featuredRest = featuredWork.slice(1);

const resumeUrl = "/Saabbir_Hossain_Senior_Frontend_Engineer_8_Years_Resume_1_v7.pdf";

// Brands I've built or tested on. Tools I use (Optimizely, Shopify) don't
// belong here — a logo row that mixes clients and software isn't honest.
const clientLogos = [
  { name: 'Wax London', logo: '/images/clients/wax-london.svg' },
  { name: 'BAT UK', logo: '/images/clients/bat-uk.svg' },
  { name: 'Raab Vital', logo: '/images/clients/raab-vital.svg' },
  { name: 'Inspectiv', logo: '/images/clients/inspectiv.svg' },
  { name: 'Pragmatic Works', logo: '/images/clients/pragmaticworks.png' },
  { name: 'A Perfect Space', logo: '/images/clients/aperfectspace.png' }
];

// Duplicated so the marquee can loop seamlessly. The duplicate track is
// hidden from screen readers; the names are read once from the list below.
const marqueeLogos = [...clientLogos, ...clientLogos];

const testimonials = [
  {
    name: 'Haley Carpenter',
    role: 'Managed me on an enterprise testing programme',
    initials: 'HC',
    date: 'June 2024',
    quote: "Saabbir is one of the best, if not THE best, developers I have ever had the pleasure of working with in my career. I recently worked with him on a large enterprise client, and he was a MAJOR reason for their testing success. He's unbelievably fast, super knowledgable, proactive, lovely to work with, and always found solutions for anything that came up. Anyone that gets to have Saabbir on their team is very lucky!",
    rating: 5
  },
  {
    name: 'Joseph Melika',
    role: 'Founder & CEO at Discloze',
    initials: 'JM',
    date: 'December 2019',
    quote: "Saabbir has been an integral part of our development operations. Despite being remote with very different timezone, he's been very capable of adapting and integrating into our US-based operations. Very creative, prompt, and skilled.",
    rating: 5
  }
];

const services = [
  {
    title: 'Shopify themes',
    description: "Built from scratch, or working inside a theme someone else wrote. Most of my time goes on the parts that are easy to get wrong and expensive to fix later: the product page, the cart, and whatever is making the first screen slow.",
  },
  {
    title: 'A/B testing',
    description: "I set up tests that answer one question at a time, then read the results honestly — including the ones that come back flat. Convert, Optimizely, VWO, Adobe Target, AB Tasty. Most of the value is in working out what's worth testing at all.",
  },
  {
    title: 'Making pages faster',
    description: "This starts with measuring the page properly instead of guessing. Then it's the unglamorous work: getting the hero image on screen sooner, stopping the header from jumping, and finding which third-party script is costing you two seconds.",
  },
  {
    title: 'Tracking and analytics',
    description: "GA4 and Tag Manager set up so the numbers mean something. If you can't trust the funnel, there's no point testing against it.",
  },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="l-section l-section--hero">
    <div class="l-container">
      <div class="c-hero">
        <div class="c-hero__content">
          <h1 class="c-hero__title">
            I build Shopify storefronts, and I test what <span class="c-hero__title-highlight">actually works</span>.
          </h1>

          <p class="c-hero__bio">
            I'm <strong>Saabbir</strong>. I've been building for the web since 2016. These days most of my work is Shopify themes, frontend performance, and A/B testing. I'm a senior engineer at EchoLogyx in Dhaka.
          </p>

          <p class="c-hero__bio">
            Most of what I know came from building things, breaking them, and working out why they broke.
          </p>

          <div class="c-hero__actions">
            <div class="c-hero__actions-row">
              <a href="/work" class="c-btn c-btn--primary c-btn--lg">
                See my work
              </a>
              <a href="/contact" class="c-btn c-btn--secondary c-btn--lg">
                Get in touch
              </a>
            </div>
            <a
              href={resumeUrl}
              download="Saabbir_Hossain_Resume.pdf"
              class="c-btn c-btn--ghost"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              Download my CV (PDF)
            </a>
          </div>
        </div>

        <!-- One real result, attributed, with its limits stated -->
        <aside class="c-hero__feature" aria-labelledby="hero-feature-title">
          <p class="c-hero__feature-label">Most recent test</p>
          <p class="c-hero__feature-client" id="hero-feature-title">Wax London — suiting pages</p>

          <p class="c-hero__feature-metric">
            <span class="c-hero__feature-value">+50%</span>
            <span class="c-hero__feature-unit">revenue per visitor</span>
          </p>

          <p class="c-hero__feature-copy">
            29 days, 14,115 visitors, one change: the first photo on the listing went from a jacket on a hanger to the same jacket on a person. Average order value went up 24% as well.
          </p>

          <p class="c-hero__feature-caveat">
            Purchase rate moved the same way but stopped at 92.6% confidence, so I don't count that part as proven.
          </p>

          <a href="/work/wax-london-model-vs-product" class="c-hero__feature-link">
            Read the full test →
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- Work -->
  <section class="l-section l-section--alt" id="work">
    <div class="l-container">
      <div class="l-section__header l-section__header--split">
        <div>
          <h2 class="l-section__title">What I've been working on</h2>
        </div>
        <a href="/work" class="c-btn c-btn--ghost">All case studies →</a>
      </div>

      {featuredHighlight && (
        <article class="c-card c-card--glass c-card--hoverable c-card--work c-card--work-metric u-mb-32">
          <div class="c-card__metric-main">
            <div class="c-card__header">
              <span class="c-tag c-tag--accent">{featuredHighlight.data.type || 'Project'}</span>
              {(featuredHighlight.data.dateRange || featuredHighlight.data.createdAt) && (
                <span class="c-card__date">{formatWorkDate(featuredHighlight.data.dateRange, featuredHighlight.data.createdAt)}</span>
              )}
            </div>
            {featuredHighlight.data.metric && (
              <>
                <div class="c-card__metric-value">{featuredHighlight.data.metric}</div>
                <div class="c-card__metric-label">{featuredHighlight.data.metricLabel}</div>
              </>
            )}
            <h3 class="c-card__title">
              <a href={`/work/${featuredHighlight.slug}`}>{featuredHighlight.data.title}</a>
            </h3>
            <p class="c-card__body">
              {featuredHighlight.data.highlight || featuredHighlight.data.description}
            </p>
            <span class="c-btn c-btn--ghost">Read the case study →</span>
          </div>
          {featuredHighlight.data.metrics?.length > 0 && (
            <div class="c-card__metric-aside">
              {featuredHighlight.data.metrics.map((item) => (
                <div class="c-card__metric-row">
                  <div class="c-card__metric-row-value">{item.value}</div>
                  <div class="c-card__metric-row-label">{item.label}</div>
                </div>
              ))}
            </div>
          )}
        </article>
      )}

      <div class="l-grid l-grid--2col">
        {featuredRest.map((item) => (
          <article class="c-card c-card--glass c-card--hoverable c-card--work c-card--work-stack">
            {workThumb(item.data.imgFolderName) && (
              <img
                class="c-card__media"
                src={workThumb(item.data.imgFolderName)!}
                alt=""
                width="414"
                height="310"
                loading="lazy"
                decoding="async"
              />
            )}
            <div class="c-card__content">
              <div class="c-card__header">
                <span class="c-tag c-tag--accent">{item.data.type || 'Project'}</span>
                {(item.data.dateRange || item.data.createdAt) && (
                  <span class="c-card__date">{formatWorkDate(item.data.dateRange, item.data.createdAt)}</span>
                )}
              </div>

              <h3 class="c-card__title">
                <a href={`/work/${item.slug}`}>{item.data.title}</a>
              </h3>

              {item.data.highlight && (
                <p class="c-card__highlight">{item.data.highlight}</p>
              )}

              <div class="c-card__body">
                {item.data.description}
              </div>

              <div class="c-card__footer">
                <div class="c-card__tags">
                  {item.data.tools?.slice(0, 4).map((tool) => (
                    <span class="c-tag">{tool}</span>
                  ))}
                </div>
                <span class="c-btn c-btn--ghost c-btn--sm">
                  Read it →
                </span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Clients -->
  <section class="l-section l-section--brands">
    <div class="l-container">
      <div class="c-clients">
        <p class="c-clients__label">Brands I've built or tested on</p>
        <div class="c-clients__marquee" aria-hidden="true">
          <div class="c-clients__marquee-track">
            {marqueeLogos.map((item) => (
              <div class="c-clients__item">
                <img src={item.logo} alt="" width="140" height="36" loading="lazy" decoding="async" />
              </div>
            ))}
          </div>
        </div>
        <p class="u-sr-only">
          Brands I've built or tested on: {clientLogos.map((c) => c.name).join(', ')}.
        </p>
        <p class="c-clients__note">Most of this was through EchoLogyx, where I work.</p>
      </div>
    </div>
  </section>

  <!-- What I work on -->
  <section class="l-section">
    <div class="l-container">
      <div class="l-section__header">
        <h2 class="l-section__title">What I work on</h2>
        <p class="u-text-muted l-section__lede">
          Four things, mostly. They overlap more than you'd think — a slow product page and a failed test are often the same problem.
        </p>
      </div>

      <div class="l-grid l-grid--2col">
        {services.map((service) => (
          <article class="c-card c-card--glass c-service-card">
            <h3 class="c-card__title">{service.title}</h3>
            <p class="c-card__body">{service.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="l-section l-section--alt">
    <div class="l-container">
      <div class="l-section__header">
        <h2 class="l-section__title">What people I've worked with said</h2>
      </div>

      <div class="l-grid l-grid--2col">
        {testimonials.map((t) => (
          <div class="c-card c-card--glass c-testimonial">
            <div class="c-testimonial__rating" role="img" aria-label={`${t.rating} out of 5`}>
              {Array.from({ length: t.rating }).map(() => (
                <span aria-hidden="true">★</span>
              ))}
            </div>
            <p class="c-testimonial__quote">{t.quote}</p>

            <div class="c-testimonial__author">
              <div class="c-testimonial__author-avatar" aria-hidden="true">{t.initials}</div>
              <div class="c-testimonial__author-info">
                <div class="c-testimonial__author-name">{t.name}</div>
                <div class="c-testimonial__author-role">{t.role}</div>
                <div class="c-testimonial__author-date">{t.date}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Writing -->
  <section class="l-section">
    <div class="l-container">
      <div class="l-section__header l-section__header--split">
        <div>
          <h2 class="l-section__title">Recent writing</h2>
        </div>
        <a href="/blog" class="c-btn c-btn--ghost">Everything I've written →</a>
      </div>

      <div class="l-grid l-grid--3col l-grid--cards">
        {recentArticles.map((article) => (
          <article class="c-card c-card--glass c-card--hoverable c-card--article">
            <div class="c-card__meta">
              {article.data.createdAt && <span>{formatDisplayDate(article.data.createdAt)}</span>}
              <span>•</span>
              <span class="c-card__meta-source">
                {article.data.externalSource || (isExternalArticle(article) ? 'External' : 'Blog')}
              </span>
            </div>

            <div class="c-card__main">
              <h3 class="c-card__title">
                <a href={articleHref(article)} {...articleLinkRel(article)}>{article.data.title}</a>
              </h3>

              <div class="c-card__body">
                {article.data.description}
              </div>
            </div>

            <div class="c-card__footer">
              <div class="c-card__tags">
                {article.data.tags?.slice(0, 3).map((tag) => (
                  <span class="c-tag">#{tag}</span>
                ))}
              </div>
              <a href={articleHref(article)} class="c-btn c-btn--ghost c-btn--sm" {...articleLinkRel(article)}>
                {isExternalArticle(article) ? `Read on ${article.data.externalSource || 'EchoLogyx'} ↗` : 'Read →'}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="l-section l-section--alt">
    <div class="l-container l-container--narrow">
      <div class="u-mb-32">
        <h2 class="l-section__title">Want to talk?</h2>
        <p class="u-text-muted">
          If you've got a Shopify build, a page that's slow, or a test you're not sure how to run — send me a note. I read everything and reply within a day or two.
        </p>
      </div>

      <div class="c-card c-card--glass">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
