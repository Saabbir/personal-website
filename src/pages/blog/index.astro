---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

function slugifyTag(tag: string) {
  return tag
    .toLowerCase()
    .trim()
    .replace(/\//g, '-')
    .replace(/\s+/g, '-');
}

const allArticles = await getCollection('articles');
const publishedArticles = allArticles
  .filter((a) => a.data.publish !== false)
  .sort((a, b) => new Date(b.data.createdAt || '').getTime() - new Date(a.data.createdAt || '').getTime());

// Collect all unique tags
const allTags = Array.from(
  new Set(publishedArticles.flatMap((a) => a.data.tags || []))
).sort();
---

<BaseLayout title="Blog & Knowledge Base" description="Articles on JavaScript, Web Performance, A/B Testing, and Frontend Architecture by Saabbir Hossain.">
  <section class="l-section">
    <div class="l-container">
      <div class="l-section__header u-text-center" style="max-width:700px; margin-left:auto; margin-right:auto;">
        <div class="l-section__subtitle">Knowledge Base</div>
        <h1 class="l-section__title">Blog & Articles</h1>
        <p class="u-text-muted u-mt-16">
          Insights on JavaScript, web performance engineering, experiment design, and front-end development.
        </p>

        <!-- Search Bar -->
        <div class="u-mt-24" style="position:relative; max-width:480px; margin-left:auto; margin-right:auto;">
          <input
            type="text"
            id="blog-search"
            class="c-form__input"
            placeholder="Search articles by title or keyword..."
            aria-label="Search articles"
          />
        </div>

        <!-- Tag Filter Pills -->
        {allTags.length > 0 && (
          <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:0.5rem; margin-top:1.5rem;">
            {allTags.map((tag) => (
              <a href={`/blog/tag/${slugifyTag(tag)}`} class="c-tag c-tag--lg">
                #{tag}
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Articles Grid -->
      <div class="l-grid l-grid--3col" id="articles-grid">
        {publishedArticles.map((article) => (
          <article
            class="c-card c-card--glass c-card--hoverable article-card"
            data-title={article.data.title.toLowerCase()}
            data-tags={JSON.stringify(article.data.tags || [])}
          >
            <div class="c-card__meta">
              {article.data.createdAt && <span>{article.data.createdAt}</span>}
              <span>•</span>
              <span style="color:var(--color-accent); font-weight:600;">Article</span>
            </div>

            <h2 class="c-card__title">
              <a href={`/blog/${article.slug}`}>{article.data.title}</a>
            </h2>

            <div class="c-card__body">
              {article.data.description}
            </div>

            <div class="c-card__footer">
              <div class="c-card__tags">
                {article.data.tags?.map((tag) => (
                  <a href={`/blog/tag/${slugifyTag(tag)}`} class="c-tag">
                    #{tag}
                  </a>
                ))}
              </div>
              <a href={`/blog/${article.slug}`} class="c-btn c-btn--ghost c-btn--sm">
                Read Article →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const searchInput = document.getElementById('blog-search');
  const cards = document.querySelectorAll('.article-card');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const tags = card.getAttribute('data-tags') || '';
        if (title.includes(query) || tags.includes(query)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  }
</script>
