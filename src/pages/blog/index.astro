---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { articleHref, articleLinkRel, isExternalArticle, slugifyTag } from '../../utils/article';
import { contentDateValue, formatDisplayDate } from '../../utils/seo';

const allSnippets = await getCollection('snippets');
const recentSnippets = allSnippets.filter((s) => s.data.publish !== false).slice(0, 3);

const allArticles = await getCollection('articles');
const publishedArticles = allArticles
  .filter((a) => a.data.publish !== false)
  .sort((a, b) => contentDateValue(b.data.createdAt) - contentDateValue(a.data.createdAt));

// Collect all unique tags
const allTags = Array.from(
  new Set(publishedArticles.flatMap((a) => a.data.tags || []))
).sort();
---

<BaseLayout
  title="Writing"
  description="Notes on Shopify, frontend performance, A/B testing and JavaScript — mostly things that broke and what fixed them."
  image="/images/og/writing.png"
>
  <section class="l-section">
    <div class="l-container">
      <div class="l-section__header u-text-center" style="max-width:700px; margin-left:auto; margin-right:auto;">
        <h1 class="l-section__title">Writing</h1>
        <p class="u-text-muted u-mt-16">
          Notes on Shopify, frontend performance, testing and JavaScript. Mostly
          things that broke, and what it took to work out why.
        </p>

        <!-- Search Bar -->
        <div class="u-mt-24" style="position:relative; max-width:480px; margin-left:auto; margin-right:auto;">
          <input
            type="text"
            id="blog-search"
            class="c-form__input"
            placeholder="Search by title or keyword"
            aria-label="Search articles"
          />
        </div>

        <!-- Tag Filter Pills -->
        {allTags.length > 0 && (
          <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:0.5rem; margin-top:1.5rem;">
            {allTags.map((tag) => (
              <a href={`/blog/tag/${slugifyTag(tag)}`} class="c-tag c-tag--lg">
                #{tag}
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Articles Grid -->
      <div class="l-grid l-grid--3col l-grid--cards" id="articles-grid">
        {publishedArticles.map((article) => (
          <article
            class="c-card c-card--glass c-card--hoverable c-card--article article-card"
            data-title={article.data.title.toLowerCase()}
            data-tags={JSON.stringify(article.data.tags || [])}
          >
            <div class="c-card__meta">
              {article.data.createdAt && <span>{formatDisplayDate(article.data.createdAt)}</span>}
              <span>•</span>
              <span style="color:var(--color-accent); font-weight:600;">
                {article.data.externalSource || (isExternalArticle(article) ? 'External' : 'Article')}
              </span>
            </div>

            <div class="c-card__main">
              <h2 class="c-card__title">
                <a href={articleHref(article)} {...articleLinkRel(article)}>{article.data.title}</a>
              </h2>

              <div class="c-card__body">
                {article.data.description}
              </div>
            </div>

            <div class="c-card__footer">
              <div class="c-card__tags">
                {article.data.tags?.map((tag) => (
                  <a href={`/blog/tag/${slugifyTag(tag)}`} class="c-tag">
                    #{tag}
                  </a>
                ))}
              </div>
              <a href={articleHref(article)} class="c-btn c-btn--ghost c-btn--sm" {...articleLinkRel(article)}>
                {isExternalArticle(article) ? `Read on ${article.data.externalSource || 'EchoLogyx'} ↗` : 'Read →'}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {recentSnippets.length > 0 && (
    <section class="l-section l-section--alt">
      <div class="l-container">
        <div class="l-section__header l-section__header--split">
          <div>
            <h2 class="l-section__title">Snippets</h2>
            <p class="u-text-muted l-section__lede">
              Shorter than an article. Small fixes I keep needing.
            </p>
          </div>
          <a href="/snippets" class="c-btn c-btn--ghost">All snippets →</a>
        </div>

        <div class="l-grid l-grid--3col">
          {recentSnippets.map((snippet) => (
            <article class="c-card c-card--glass c-card--hoverable">
              <h3 class="c-card__title">
                <a href={`/snippets/${snippet.slug}`}>{snippet.data.title}</a>
              </h3>
              <p class="c-card__body">{snippet.data.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  document.addEventListener('input', (e) => {
    const searchInput = e.target as HTMLInputElement;
    if (searchInput.id !== 'blog-search') return;

    const query = searchInput.value.toLowerCase().trim();
    document.querySelectorAll<HTMLElement>('.article-card').forEach((card) => {
      const title = card.getAttribute('data-title') || '';
      const tags = card.getAttribute('data-tags') || '';
      card.style.display = title.includes(query) || tags.includes(query) ? '' : 'none';
    });
  });
</script>
