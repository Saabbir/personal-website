---
---
<div class="c-chat-widget" transition:persist="chat-widget">
  <div class="c-chat-widget__menu" id="chat-menu">
    <a
      href="https://wa.me/8801789243439"
      target="_blank"
      rel="noopener noreferrer"
      class="c-chat-widget__item"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00e599" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
      WhatsApp Chat
    </a>
    <a
      href="mailto:thesaabbir@gmail.com"
      class="c-chat-widget__item"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#00d2ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
      Send Email
    </a>
  </div>

  <button
    class="c-chat-widget__trigger"
    id="chat-trigger"
    aria-label="Open communication quick options"
    type="button"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"></path>
    </svg>
  </button>
</div>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    const chatTrigger = document.getElementById('chat-trigger');
    const chatMenu = document.getElementById('chat-menu');
    if (!chatTrigger || !chatMenu) return;

    if (target.closest('#chat-trigger')) {
      chatMenu.classList.toggle('c-chat-widget__menu--open');
      return;
    }

    if (!target.closest('.c-chat-widget')) {
      chatMenu.classList.remove('c-chat-widget__menu--open');
    }
  });
</script>
