---
---
<form class="c-form" id="contact-form">
  <div class="c-form__group">
    <label for="name" class="c-form__label">Your Name</label>
    <input type="text" id="name" name="name" class="c-form__input" placeholder="e.g. Alex Smith" required />
  </div>

  <div class="c-form__group">
    <label for="email" class="c-form__label">Email Address</label>
    <input type="email" id="email" name="email" class="c-form__input" placeholder="e.g. alex@example.com" required />
  </div>

  <div class="c-form__group">
    <label for="subject" class="c-form__label">Subject</label>
    <input type="text" id="subject" name="subject" class="c-form__input" placeholder="e.g. Shopify Plus Consultation / Project Inquiry" required />
  </div>

  <div class="c-form__group">
    <label for="message" class="c-form__label">Message</label>
    <textarea id="message" name="message" class="c-form__textarea" placeholder="How can I help your ecommerce brand?" required></textarea>
  </div>

  <!-- Honeypot anti-spam field -->
  <input type="text" name="_gotcha" style="display:none !important;" tabindex="-1" autocomplete="off" />

  <div id="form-feedback" class="c-form__feedback" style="display:none;"></div>

  <button type="submit" class="c-btn c-btn--primary c-btn--lg" id="submit-btn">
    Send Message
  </button>
</form>

<script>
  document.addEventListener('submit', async (e) => {
    const form = (e.target as Element).closest('#contact-form') as HTMLFormElement | null;
    if (!form) return;
    e.preventDefault();

    const feedback = document.getElementById('form-feedback') as HTMLElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    if (!feedback || !submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    feedback.style.display = 'none';

    const formData = new FormData(form);
    const name = formData.get('name');
    const email = formData.get('email');
    const subject = formData.get('subject');
    const message = formData.get('message');

    try {
      const response = await fetch('https://formspree.io/f/thesaabbir@gmail.com', {
        method: 'POST',
        body: JSON.stringify({ name, email, subject, message }),
        headers: {
          'Accept': 'application/json',
          'Content-Type': 'application/json'
        }
      });

      if (response.ok || response.status === 200) {
        feedback.className = 'c-form__feedback c-form__feedback--success';
        feedback.textContent = 'Thank you! Your message has been sent successfully. I will get back to you shortly.';
        feedback.style.display = 'block';
        form.reset();
      } else {
        window.location.href = `mailto:thesaabbir@gmail.com?subject=${encodeURIComponent(String(subject))}&body=${encodeURIComponent(String(message))}`;
        feedback.className = 'c-form__feedback c-form__feedback--success';
        feedback.textContent = 'Opening your mail application... Feel free to send directly to thesaabbir@gmail.com!';
        feedback.style.display = 'block';
      }
    } catch (err) {
      window.location.href = `mailto:thesaabbir@gmail.com?subject=${encodeURIComponent(String(subject))}&body=${encodeURIComponent(String(message))}`;
      feedback.className = 'c-form__feedback c-form__feedback--success';
      feedback.textContent = 'Opening your mail application... Feel free to send directly to thesaabbir@gmail.com!';
      feedback.style.display = 'block';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Message';
    }
  });
</script>
