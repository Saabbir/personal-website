---
// Formspree form id. This must be the hash from the endpoint Formspree gives
// you, not an email address — the previous value was
// https://formspree.io/f/thesaabbir@gmail.com, which answers 404
// {"error":"This form isn't set up yet"}, so nothing was ever delivered.
const FORM_ID = 'mkjgnwva';
const FORM_ENDPOINT = `https://formspree.io/f/${FORM_ID}`;
const CONTACT_EMAIL = 'thesaabbir@gmail.com';
---
<form
  class="c-form"
  id="contact-form"
  data-endpoint={FORM_ENDPOINT}
  data-email={CONTACT_EMAIL}
>
  <div class="c-form__group">
    <label for="name" class="c-form__label">Your name</label>
    <input type="text" id="name" name="name" class="c-form__input" autocomplete="name" required />
  </div>

  <div class="c-form__group">
    <label for="email" class="c-form__label">Email</label>
    <input type="email" id="email" name="email" class="c-form__input" autocomplete="email" required />
  </div>

  <div class="c-form__group">
    <label for="subject" class="c-form__label">What's this about?</label>
    <input type="text" id="subject" name="subject" class="c-form__input" required />
  </div>

  <div class="c-form__group">
    <label for="message" class="c-form__label">Message</label>
    <textarea
      id="message"
      name="message"
      class="c-form__textarea"
      placeholder="Tell me what you're working on, and what's not working."
      required
    ></textarea>
  </div>

  <!-- Honeypot anti-spam field -->
  <input type="text" name="_gotcha" style="display:none !important;" tabindex="-1" autocomplete="off" />

  <button type="submit" class="c-btn c-btn--primary c-btn--lg c-form__submit" id="submit-btn">
    <span class="c-form__spinner" aria-hidden="true"></span>
    <span class="c-form__submit-label">Send message</span>
  </button>

  <div id="form-feedback" class="c-form__feedback" role="status" aria-live="polite" style="display:none;"></div>
</form>

<script>
  // Capture phase on purpose. Astro's ViewTransitions router also listens for
  // 'submit' on document, and with no action attribute it navigates to
  // location.pathname — which reloaded the page and jumped to the top before
  // this handler ever ran. Its listener is bubble-phase and bails on
  // e.defaultPrevented, so preventDefault() during capture stops it.
  document.addEventListener('submit', async (e) => {
    const form = (e.target as Element).closest('#contact-form') as HTMLFormElement | null;
    if (!form) return;
    e.preventDefault();

    const feedback = document.getElementById('form-feedback') as HTMLElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    if (!feedback || !submitBtn) return;

    const endpoint = form.dataset.endpoint || '';
    const email = form.dataset.email || '';

    const show = (state: 'success' | 'error', html: string) => {
      feedback.className = `c-form__feedback c-form__feedback--${state}`;
      feedback.innerHTML = html;
      feedback.style.display = 'block';
    };

    const failed = () => {
      show(
        'error',
        `That didn't send — something went wrong on my end. Email me directly at <a href="mailto:${email}">${email}</a> and I'll pick it up from there.`,
      );
    };

    // No endpoint configured yet — don't pretend to send.
    if (!endpoint) {
      failed();
      return;
    }

    const label = submitBtn.querySelector('.c-form__submit-label');
    const setSending = (sending: boolean) => {
      submitBtn.disabled = sending;
      submitBtn.dataset.sending = sending ? 'true' : 'false';
      submitBtn.setAttribute('aria-busy', String(sending));
      if (label) label.textContent = sending ? 'Sending…' : 'Send message';
    };

    setSending(true);
    feedback.style.display = 'none';

    const formData = new FormData(form);

    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        body: JSON.stringify({
          name: formData.get('name'),
          email: formData.get('email'),
          subject: formData.get('subject'),
          message: formData.get('message'),
        }),
        headers: {
          Accept: 'application/json',
          'Content-Type': 'application/json',
        },
      });

      if (response.ok) {
        show('success', "Thanks — that's come through. I'll get back to you in a day or two.");
        form.reset();
      } else {
        failed();
      }
    } catch (err) {
      failed();
    } finally {
      setSending(false);
    }
  }, true);
</script>
